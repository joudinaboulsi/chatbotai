# Copy to backend/.env and fill in real values. Never commit the real .env.

ENVIRONMENT=development
APP_NAME=AI Chatbot Platform

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

CORS_ORIGINS=["http://localhost:5173"]
WIDGET_ALLOWED_ORIGINS=["*"]

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage
MAX_UPLOAD_SIZE_MB=20

RATE_LIMIT_WIDGET_PER_MINUTE=30

FRONTEND_BASE_URL=http://localhost:5173
WIDGET_SCRIPT_BASE_URL=http://localhost:8000

# SMSC API integration - seeds the admin-editable smsc_settings row on first
# run. The chatbot only ever talks to this HTTPS API, never to the SMSC
# MySQL database directly.
SMSC_API_BASE_URL=
SMSC_API_KEY=
SMSC_API_TIMEOUT=10
SMSC_SESSION_EXPIRE_MINUTES=30
